# Folders NOT uploaded to EAS
# android/ source is committed so EAS uses our pinned Gradle 8.13
# But we exclude all build artifacts to keep the archive small
dist/
web/
web-build/

# Android build artifacts (regenerated on EAS server — exclude to reduce upload size)
android/.gradle/
android/.gradle-build/
android/.gradle-project-cache/
android/.kotlin/
android/build/
android/app/.cxx/
android/app/build/

# Dev/docs folders not needed for build
docs/
scratch/
.git/
.git-rewrite/
.vscode/

# Large test/translation scripts not needed
auto_translate_all.js
check_untranslated.js
fix_translations.js
sync_translations.js
translate_exercises.js

# Logs and other unnecessary files
*.log
migración.html
schema.json
