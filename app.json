{
  "expo": {
    "name": "FitGO",
    "slug": "fitgo",
    "owner": "deathtrooper",
    "version": "1.0.2",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0F172A"
    },
    "scheme": "fitgo",
    "splash": {
      "image": "./assets/transparent.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0F14"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.fitgo.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Scan food barcodes and take progress photos",
        "NSMicrophoneUsageDescription": "Use voice to log food and talk with your AI coach",
        "NSPhotoLibraryUsageDescription": "Access your photo library for progress photos",
        "NSMotionUsageDescription": "Allow FitGO to count your steps to track your daily activity.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fitgo.app",
      "versionCode": 15,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D0F14"
      },
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "VIBRATE",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.ACTIVITY_RECOGNITION",
        "com.android.vending.BILLING",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.jpg"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow FitGO to access your camera to scan food barcodes and take progress photos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow FitGO to access your microphone to log food and talk with your AI coach."
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#7C5CFC"
        }
      ],
      "react-native-fast-tflite",
      "expo-video",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-6675982933894700~4114813863",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "FitGoMainWidget",
              "label": "FitGO – Resumen del Día",
              "minWidth": "250dp",
              "minHeight": "110dp",
              "description": "Calorías restantes, proteína y racha actual",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "FitGoStreakWidget",
              "label": "FitGO – Llama de Racha",
              "minWidth": "110dp",
              "minHeight": "55dp",
              "description": "Tu racha de días activos en FitGO",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 3600000
            },
            {
              "name": "FitGoWaterWidget",
              "label": "FitGO – Hidratación",
              "minWidth": "110dp",
              "minHeight": "110dp",
              "description": "Tu consumo de agua del día",
              "previewImage": "./assets/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/fitgo"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b322d830-a5f8-4c68-83b5-8686ce3d38f3"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
