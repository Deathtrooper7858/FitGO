{
  "name": "fitgo",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "react-native start",
    "start:expo": "expo start --dev-client",
    "start:dev": "cross-env APP_VARIANT=development npx expo start",
    "android": "expo run:android",
    "android:build": "expo run:android",
    "android:dev": "cross-env APP_VARIANT=development expo run:android",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "predeploy": "expo export -p web && node -e \"require('fs').writeFileSync('dist/.nojekyll', ''); require('fs').copyFileSync('dist/index.html', 'dist/404.html');\"",
    "deploy": "gh-pages -d dist",
    "prebuild": "expo prebuild --platform android --clean",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts,.tsx --max-warnings 100",
    "typecheck": "tsc --noEmit",
    "ci:audit": "npm audit --audit-level=high --omit=dev",
    "ci:all": "npm run ci:audit && npm run lint && npm run typecheck && npm test",
    "bundle:analyze:android": "npx react-native bundle --platform android --dev false --entry-file index.ts --bundle-output .bundle/android.js && npx react-native-bundle-visualizer --bundle .bundle/android.js --platform android",
    "bundle:analyze:ios": "npx react-native bundle --platform ios --dev false --entry-file index.ts --bundle-output .bundle/ios.js && npx react-native-bundle-visualizer --bundle .bundle/ios.js --platform ios",
    "prepare": "node -e \"try { require('husky')() } catch (e) {}\""
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "react-test-renderer": "19.2.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.105.0",
    "axios": "^1.15.2",
    "base64-arraybuffer": "^1.0.2",
    "expo": "~55.0.26",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.14",
    "expo-auth-session": "~55.0.16",
    "expo-av": "^16.0.8",
    "expo-blur": "~55.0.14",
    "expo-camera": "~55.0.19",
    "expo-clipboard": "~55.0.13",
    "expo-constants": "~55.0.16",
    "expo-crypto": "~55.0.15",
    "expo-dev-client": "~55.0.35",
    "expo-device": "~55.0.17",
    "expo-document-picker": "~55.0.4",
    "expo-file-system": "~55.0.19",
    "expo-haptics": "~55.0.14",
    "expo-image": "~55.0.11",
    "expo-image-picker": "~55.0.20",
    "expo-linear-gradient": "~55.0.14",
    "expo-linking": "~55.0.15",
    "expo-navigation-bar": "~55.0.13",
    "expo-notifications": "~55.0.23",
    "expo-print": "~55.0.15",
    "expo-router": "~55.0.16",
    "expo-secure-store": "~55.0.14",
    "expo-sensors": "~55.0.15",
    "expo-sharing": "~55.0.20",
    "expo-splash-screen": "~55.0.21",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.18",
    "expo-updates": "~55.0.24",
    "expo-video": "~55.0.17",
    "expo-web-browser": "~55.0.16",
    "i18next": "^26.0.8",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.6",
    "react-native": "0.83.6",
    "react-native-android-widget": "^0.20.3",
    "react-native-body-highlighter": "^3.2.0",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-gifted-charts": "^1.4.76",
    "react-native-google-mobile-ads": "^16.3.3",
    "react-native-nitro-image": "^0.15.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-purchases": "^10.1.0",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-vision-camera": "^5.0.11",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.7.4",
    "xlsx": "^0.18.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.19",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.18",
    "lint-staged": "^17.0.7",
    "react-native-bundle-visualizer": "^4.0.0",
    "react-test-renderer": "19.2.0",
    "supabase": "^2.98.2",
    "typescript": "~5.9.2"
  },
  "private": true
}
