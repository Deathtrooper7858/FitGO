    "expo-secure-store": "~55.0.17",
    "expo-sensors": "~55.0.18",
    "expo-sharing": "~55.0.23",
    "expo-splash-screen": "~55.0.24",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.21",
    "expo-updates": "~55.0.27",
    "expo-video": "~55.0.20",
    "expo-web-browser": "~55.0.19",
    "i18next": "^26.0.8",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-i18next": "^17.0.6",
    "react-native": "0.83.10",
    "react-native-android-widget": "^0.20.3",
    "react-native-body-highlighter": "^3.2.0",
    "react-native-fast-tflite": "^3.0.1",
