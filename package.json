{
  "name": "fitgo",
  "version": "1.0.2",
  "main": "index.ts",
  "scripts": {
    "start": "react-native start",
    "start:expo": "expo start --dev-client",
    "start:dev": "adb reverse tcp:8081 tcp:8081 2>nul & cross-env APP_VARIANT=development NODE_OPTIONS=\"--max-old-space-size=3072 --expose-gc\" npx expo start --localhost",
    "android:dev:run": "powershell -Command \"adb reverse tcp:8081 tcp:8081; cd android; .\\gradlew.bat app:installDevelopmentDebug --build-cache -PreactNativeArchitectures=arm64-v8a -PreactNativeDevServerPort=8081; Write-Host 'Re-estableciendo tunel adb...'; adb reverse tcp:8081 tcp:8081; Start-Sleep -Seconds 1; adb shell am start -a android.intent.action.VIEW -d 'exp+fitgo-dev://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081' com.fitgo.app.dev; Write-Host 'App lanzada.'\"",
    "android:clean": "powershell -Command \"Remove-Item -Recurse -Force android\\.gradle-build -ErrorAction SilentlyContinue; Remove-Item -Recurse -Force android\\build -ErrorAction SilentlyContinue; powershell -ExecutionPolicy Bypass -File scripts/clean-gradle-cache.ps1; Write-Host 'Android clean done.'\"",
    "open:android": "adb reverse tcp:8081 tcp:8081 & adb shell am start -a android.intent.action.VIEW -d \"exp+fitgo-dev://expo-development-client/?url=http%3A%2F%2F127.0.0.1%3A8081\" com.fitgo.app.dev",
    "android": "cross-env ANDROID_HOME=C:/Users/Anubiz/AppData/Local/Android/Sdk ANDROID_SDK_ROOT=C:/Users/Anubiz/AppData/Local/Android/Sdk expo run:android",
    "android:build": "cross-env ANDROID_HOME=C:/Users/Anubiz/AppData/Local/Android/Sdk ANDROID_SDK_ROOT=C:/Users/Anubiz/AppData/Local/Android/Sdk expo run:android",
    "android:dev": "cross-env ANDROID_HOME=C:/Users/Anubiz/AppData/Local/Android/Sdk ANDROID_SDK_ROOT=C:/Users/Anubiz/AppData/Local/Android/Sdk APP_VARIANT=development expo run:android --variant developmentDebug",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "predeploy": "expo export -p web && node -e \"require('fs').writeFileSync('dist/.nojekyll', ''); require('fs').copyFileSync('dist/index.html', 'dist/404.html');\"",
    "deploy": "gh-pages -d dist",
    "prebuild": "expo prebuild --platform android --clean",
    "audit:prod": "npm audit --omit=dev",
    "audit:all": "npm audit",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint . --max-warnings 300",
    "typecheck": "tsc --noEmit",
    "ci:audit": "npm audit --audit-level=high --omit=dev",
    "ci:all": "npm run ci:audit && npm run lint && npm run typecheck && npm test",
    "bundle:analyze:android": "npx react-native bundle --platform android --dev false --entry-file index.ts --bundle-output .bundle/android.js && npx react-native-bundle-visualizer --bundle .bundle/android.js --platform android",
    "build:preview": "npx eas-cli build --profile preview --platform android",
    "build:prod": "npx eas-cli build --profile production --platform android",
    "build:prod:all": "npx eas-cli build --profile production --platform all",
    "android:prod:bundle": "powershell -Command \"$env:ANDROID_HOME='C:/Users/Anubiz/AppData/Local/Android/Sdk'; $env:ANDROID_SDK_ROOT='C:/Users/Anubiz/AppData/Local/Android/Sdk'; $env:APP_VARIANT='production'; $env:SENTRY_DISABLE_AUTO_UPLOAD='true'; cd android; .\\gradlew.bat app:bundleRelease\"",
    "android:prod:apk": "powershell -Command \"$env:ANDROID_HOME='C:/Users/Anubiz/AppData/Local/Android/Sdk'; $env:ANDROID_SDK_ROOT='C:/Users/Anubiz/AppData/Local/Android/Sdk'; $env:APP_VARIANT='production'; $env:SENTRY_DISABLE_AUTO_UPLOAD='true'; cd android; .\\gradlew.bat app:assembleRelease\"",
    "prepare": "node -e \"try { require('husky')() } catch (e) {}\""
  },
  "overrides": {
    "postcss": "^8.5.10",
    "uuid": "^14.0.0",
    "react-test-renderer": "19.2.0"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.6.0",
    "@react-native-community/netinfo": "11.5.2",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "@supabase/supabase-js": "^2.105.0",
