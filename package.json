    "react-native-worklets": "0.7.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.2/xlsx-0.20.2.tgz",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^20.1.3",
    "@react-native/metro-config": "^0.85.3",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.10",
    "babel-preset-expo": "~55.0.19",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~55.0.1",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-expo": "~55.0.21",
    "lint-staged": "^15.4.3",
    "react-native-bundle-visualizer": "^4.0.0",
    "react-test-renderer": "19.2.0",
    "supabase": "^2.98.2",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-fast-tflite",
          "expo-av"
        ]
      }
    },
    "install": {
      "exclude": [
        "expo-av"
      ]
    }
  },
  "private": true
}
